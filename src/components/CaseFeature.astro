---
import { caseUrl, bestaat, type Case, srcset } from '@/lib/site';
interface Props {
  item: Case;
  koptag?: 'h2' | 'h3';
}
const { item, koptag = 'h3' } = Astro.props;
const d = item.data;
const Kop = koptag;
const beeld = bestaat(d.afbeelding) ? d.afbeelding : null;
---

<a href={caseUrl(item)} class="group relative isolate flex flex-wrap overflow-hidden rounded-[14px] bg-navy text-white hover:text-white">
  <div class="relative min-h-[300px] flex-[1_1_440px] overflow-hidden bg-navy-700 md:min-h-[420px]">
    {
      beeld ? (
        <img src={beeld} srcset={srcset(beeld)} sizes="(min-width: 768px) 50vw, 100vw" alt="" loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover transition-transform duration-[900ms] ease-out group-hover:scale-[1.05]" />
      ) : (
        <div class="raster-licht absolute inset-0" aria-hidden="true" />
      )
    }
    <div class="absolute inset-0 bg-gradient-to-t from-navy/85 via-navy/10 to-transparent" aria-hidden="true" />
    <span class="absolute bottom-6 left-6 text-3xl font-bold tracking-strak md:bottom-8 md:left-8 md:text-5xl">{d.klant}</span>
    <ul class="absolute top-5 left-5 flex flex-wrap gap-1.5" aria-label="Kenmerken">
      {d.tags.slice(0, 3).map((t) => <li class="rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-navy backdrop-blur">{t}</li>)}
    </ul>
  </div>
  <div class="relative flex flex-[1_1_400px] flex-col justify-center gap-4 overflow-hidden p-7 md:p-14">
    <div class="gloed-donker pointer-events-none absolute inset-0 opacity-70" aria-hidden="true"></div>
    <span class="relative text-sm text-navy-tekst">{d.klant} · {d.branche}</span>
    <span class:list={['relative leading-[1] font-bold tracking-strak whitespace-nowrap text-paars-licht', d.hoofdcijfer.length > 7 ? 'text-[clamp(2.25rem,3.6vw,3.5rem)]' : 'text-[clamp(2.75rem,5.2vw,4.75rem)]']}>{d.hoofdcijfer}</span>
    <Kop class="relative text-xl leading-snug font-medium md:text-[21px]">{d.hoofdcijferLabel}</Kop>
    <span class="relative inline-flex items-center gap-2 font-semibold text-paars-licht">
      Lees de case
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="transition-transform group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </span>
  </div>
</a>
