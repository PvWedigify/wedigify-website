---
/** Kleine set lijn-iconen (stroke = currentColor). */
interface Props {
  name: 'pijl' | 'pijl-omlaag' | 'chevron' | 'menu' | 'sluit' | 'telefoon' | 'mail' | 'plus' | 'min' | 'linkedin' | 'instagram' | 'check' | 'locatie';
  class?: string;
  size?: number;
  [key: string]: unknown;
}
const { name, class: className = '', size = 20, ...rest } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  {...rest}
>
  {name === 'pijl' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'chevron' && <path d="m6 9 6 6 6-6" />}
  {name === 'pijl-omlaag' && <path d="M12 5v14M6 13l6 6 6-6" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'sluit' && <path d="M6 6l12 12M18 6L6 18" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'min' && <path d="M5 12h14" />}
  {name === 'check' && <path d="M5 12.5l4.5 4.5L19 7.5" />}
  {
    name === 'telefoon' && (
      <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" />
    )
  }
  {
    name === 'mail' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="M3 7l9 6 9-6" />
      </>
    )
  }
  {
    name === 'locatie' && (
      <>
        <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" />
        <circle cx="12" cy="9.5" r="2.5" />
      </>
    )
  }
  {
    name === 'linkedin' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="3" />
        <path d="M8 10.5V16M8 7.5v.01M12 16v-3.2a2.3 2.3 0 0 1 4.6 0V16M12 10.5V16" />
      </>
    )
  }
  {
    name === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <path d="M17.5 6.5v.01" />
      </>
    )
  }
</svg>
