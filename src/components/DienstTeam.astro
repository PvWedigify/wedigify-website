---
/** Wie er aan de dienst werkt (portretten) naast de stappen van de samenwerking. */
import Icon from './Icon.astro';
import type { Teamlid } from '@/lib/site';

interface Props {
  mensen: Teamlid[];
  stappen: { label?: string | null; titel: string; tekst: string }[];
  dienstNaam: string;
}
const { mensen, stappen, dienstNaam } = Astro.props;
const eerste = mensen[0];
---

<section class="container-w sectie-s">
  <div class="grid gap-x-16 gap-y-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)]">
    <div data-reveal>
      <p class="eyebrow mb-4">Samen aan de slag</p>
      <h2 class="kop-2">Zo pakken we het <span class="text-paars">samen aan.</span></h2>
      {eerste && <p class="lead mt-5 max-w-[520px]">Je werkt met vaste gezichten die je webshop kennen. {eerste.data.naam} is je aanspreekpunt voor {dienstNaam.toLowerCase()}.</p>}
      <a href="/contact/" class="knop-paars mt-8">Plan een vrijblijvend gesprek <Icon name="pijl" size={18} /></a>
    </div>
    {
      stappen.length > 0 && (
        <ol class="relative flex flex-col gap-4 self-center" data-reveal style="--vertraging:120ms">
          {stappen.map((s, i) => (
            <li class="relative flex gap-5 rounded-kaart border border-lijn bg-white p-6 md:p-7">
              <span class="text-[clamp(2rem,3vw,2.75rem)] leading-none font-bold tracking-strak text-paars-200">{String(i + 1).padStart(2, '0')}</span>
              <div>
                {s.label && !/^stap/i.test(s.label) && <div class="text-[13px] font-semibold text-paars">{s.label}</div>}
                <h3 class="text-xl font-semibold tracking-kop">{s.titel}</h3>
                <p class="mt-1.5 leading-relaxed text-tekst">{s.tekst}</p>
              </div>
            </li>
          ))}
        </ol>
      )
    }
  </div>
</section>
