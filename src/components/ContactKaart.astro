---
import Avatar from './Avatar.astro';
import { getSite } from '@/lib/site';
import type { Teamlid } from '@/lib/site';

interface Props {
  persoon?: Teamlid | null;
  rolOverride?: string;
  variant?: 'licht' | 'navy';
}
const { persoon, rolOverride, variant = 'licht' } = Astro.props;
const site = await getSite();
const naam = persoon?.data.naam ?? 'Team Wedigify';
const rol = rolOverride ?? persoon?.data.rol ?? 'Neem contact op';
---

<div
  class:list={[
    'flex items-center gap-4 rounded-kaart p-5',
    variant === 'licht' ? 'border border-lijn bg-lavendel' : 'bg-navy text-white',
  ]}
>
  <Avatar naam={naam} foto={persoon?.data.foto} />
  <div class="flex flex-col gap-0.5">
    <span class="font-semibold">{naam}</span>
    <span class:list={['text-sm', variant === 'licht' ? 'text-tekst' : 'text-navy-tekst']}>{rol}</span>
    {
      site.telefoon && (
        <a href={`tel:${site.telefoonLink}`} class:list={['inline-block py-0.5 text-sm font-medium', variant === 'licht' ? 'text-paars hover:text-paars-donker' : 'text-paars-licht hover:text-white']}>
          {site.telefoon}
        </a>
      )
    }
    {
      site.email && (
        <a href={`mailto:${site.email}`} class:list={['inline-block py-0.5 text-sm', variant === 'licht' ? 'text-paars hover:text-paars-donker' : 'text-paars-licht hover:text-white']}>
          {site.email}
        </a>
      )
    }
  </div>
</div>
