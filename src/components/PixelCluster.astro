---
/** Decoratief pixel-motief uit het logo. Maximaal één per scherm. */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
// 0 = leeg, 1 = paars, 2 = lichtpaars
const raster = [
  [0, 0, 2, 1],
  [0, 1, 0, 2],
  [2, 0, 1, 0],
];
---

<div class:list={['grid grid-cols-4 gap-2.5', className]} aria-hidden="true">
  {
    raster.flat().map((v) => (
      <span class:list={['size-5 rounded-[5px] md:size-7 md:rounded-md', v === 1 && 'bg-paars', v === 2 && 'bg-paars-200']} />
    ))
  }
</div>
