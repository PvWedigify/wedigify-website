---
/** Collage van teamfoto's met een zwevende kaart: wie er aan je webshop werkt. */
import { getTeam, bestaat } from '@/lib/site';
interface Props {
  titel?: string;
  tekst?: string;
  class?: string;
}
const { titel = 'Vast team in Rotterdam', tekst, class: className = '' } = Astro.props;
const team = (await getTeam()).filter((t) => bestaat(t.data.foto));
const fotos = team.slice(0, 6);
const totaal = (await getTeam()).length;
---

<div class:list={['relative', className]}>
  <div class="grid grid-cols-3 gap-2.5">
    {
      fotos.map((t, i) => (
        <figure class:list={['relative overflow-hidden rounded-[12px] bg-paars-50', i % 2 === 1 ? 'translate-y-5' : '']}>
          <img src={t.data.foto} alt={`${t.data.naam}, ${t.data.rol}`} loading="lazy" decoding="async" class="aspect-[4/5] w-full object-cover grayscale-[15%] transition-all duration-500 hover:grayscale-0" />
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-navy/80 to-transparent p-2.5 text-[12px] leading-tight text-white">
            <span class="block font-semibold">{t.data.naam}</span>
            <span class="text-white/75">{t.data.rol}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>
  <div class="zweef absolute -bottom-6 left-4 rounded-[12px] border border-lijn bg-white p-4 shadow-[0_24px_50px_-20px_rgb(10_13_49/0.35)] sm:-left-6">
    <div class="text-3xl leading-none font-bold text-paars">{totaal}</div>
    <div class="mt-1 text-[13px] font-semibold text-navy">{titel}</div>
    {tekst && <div class="mt-0.5 max-w-[200px] text-[12px] leading-snug text-tekst">{tekst}</div>}
  </div>
</div>
