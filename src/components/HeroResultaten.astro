---
/**
 * Resultaatkaarten in de homepage-hero, gevoed door echte cases.
 * Opbouw: grote kaart boven, twee kleinere kaarten eronder die licht overlappen
 * met de lege onderrand van de grote kaart (nooit met tekst).
 */
import { caseUrl, bestaat, type Case, srcset } from '@/lib/site';
interface Props {
  cases: Case[];
}
const [a, b, c] = Astro.props.cases;
---

<div class="relative mx-auto w-full max-w-[540px]" aria-label="Uitgelichte resultaten">
  <div class="absolute top-[42%] -left-2 -z-10 hidden grid-cols-3 gap-2 sm:grid" aria-hidden="true">
    <span class="size-5 rounded-[5px] bg-paars"></span>
    <span class="size-5"></span>
    <span class="size-5 rounded-[5px] bg-paars-200"></span>
    <span class="size-5"></span>
    <span class="size-5 rounded-[5px] bg-paars-200"></span>
  </div>

  {
    a && (
      <a
        href={caseUrl(a)}
        class="group relative z-0 block overflow-hidden rounded-[14px] border border-lijn bg-white shadow-[0_24px_60px_-24px_rgb(10_13_49/0.25)] hover:text-navy sm:ml-[14%]"
      >
        <div class="strepen relative aspect-[16/8] overflow-hidden">
          {bestaat(a.data.afbeelding) && (
            <img src={a.data.afbeelding} srcset={srcset(a.data.afbeelding)} sizes="(min-width: 1024px) 460px, 100vw" alt="" class="absolute inset-0 size-full object-cover transition-transform duration-700 group-hover:scale-105" fetchpriority="high" />
          )}
          <span class="absolute top-3 left-3 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold backdrop-blur">{a.data.klant}</span>
        </div>
        <div class="flex items-end justify-between gap-4 px-5 pt-5 pb-5 sm:pb-14">
          <div class="min-w-0">
            <div class="text-4xl leading-none font-bold tracking-strak text-paars">{a.data.hoofdcijfer}</div>
            <div class="mt-2 text-sm leading-snug text-tekst">{a.data.hoofdcijferLabel}</div>
          </div>
          <svg class="h-10 w-24 shrink-0 text-paars" viewBox="0 0 96 40" fill="none" aria-hidden="true">
            <path class="teken-lijn" d="M2 36 C 20 34, 26 22, 40 24 S 62 10, 74 12 S 88 4, 94 2" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
          </svg>
        </div>
      </a>
    )
  }

  <div class="relative z-10 mt-3 flex flex-col gap-3 sm:-mt-9 sm:flex-row sm:items-start">
    {
      b && (
        <a
          href={caseUrl(b)}
          class="zweef block rounded-[14px] border border-lijn bg-white p-5 shadow-[0_24px_60px_-24px_rgb(10_13_49/0.3)] hover:text-navy sm:w-[52%]"
          data-reveal
          style="--vertraging:150ms"
        >
          <div class="flex items-center gap-2 text-xs font-semibold text-stil">
            <span class="puls-stip size-2 rounded-full bg-paars" />
            {b.data.klant}
          </div>
          <div class="mt-3 text-[2.5rem] leading-none font-bold tracking-strak">{b.data.hoofdcijfer}</div>
          <div class="mt-2 text-sm leading-snug text-tekst">{b.data.hoofdcijferLabel}</div>
          <div class="mt-4 flex h-11 items-end gap-1.5" aria-hidden="true">
            {[28, 36, 32, 48, 56, 70, 100].map((h, i) => (
              <span class:list={['flex-1 rounded-t-[3px]', i === 6 ? 'bg-paars' : 'bg-paars-100']} style={`height:${h}%`} />
            ))}
          </div>
        </a>
      )
    }
    {
      c && (
        <a
          href={caseUrl(c)}
          class="zweef-traag hidden rounded-[14px] bg-navy p-5 text-white shadow-[0_24px_60px_-24px_rgb(10_13_49/0.5)] hover:text-white sm:mt-14 sm:block sm:w-[48%]"
          data-reveal
          style="--vertraging:300ms"
        >
          <div class="text-xs font-semibold text-navy-stil">{c.data.klant}</div>
          <div class="mt-2 text-3xl leading-none font-bold tracking-strak text-paars-licht">{c.data.hoofdcijfer}</div>
          <div class="mt-2 text-[13px] leading-snug text-navy-tekst">{c.data.hoofdcijferLabel}</div>
        </a>
      )
    }
  </div>
</div>
