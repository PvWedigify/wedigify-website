---
import Icon from './Icon.astro';
import Achtergrond from './Achtergrond.astro';
interface Props {
  titel: string;
  label?: string;
  href?: string;
  intro?: string | null;
  punten?: string[];
}
const { titel, label = 'Plan een groeisessie', href = '/contact/', intro, punten = [] } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-paars text-white">
  <Achtergrond variant="paars" />
  <div class="container-w relative flex flex-wrap items-end justify-between gap-8 py-14 md:py-20 lg:py-24" data-reveal>
    <div class="max-w-[780px] min-w-0">
      <h2 class="kop-2 text-white">{titel}</h2>
      {intro && <p class="mt-4 max-w-[620px] text-lg leading-relaxed text-paars-100">{intro}</p>}
    </div>
    <div class="flex flex-col gap-4">
      <a href={href} class="knop-wit group self-start">{label} <Icon name="pijl" size={18} class="transition-transform group-hover:translate-x-1" /></a>
      {
        punten.length > 0 && (
          <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-paars-100">
            {punten.map((p) => (
              <li class="flex items-center gap-2"><Icon name="check" size={16} class="text-white" />{p}</li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</section>
