---
/**
 * Decoratieve UI-illustraties per dienst (geen stockfoto's): een "app-venster"
 * met inhoud die past bij de dienst, plus een optionele zwevende badge.
 */
import LijnIcoon from './LijnIcoon.astro';

export const visualTypes = ['dashboard', 'heatmap', 'code', 'lighthouse', 'migratie', 'checklist', 'schild', 'koppeling', 'zoek', 'ads', 'mail', 'content', 'ai'] as const;
export type VisualType = (typeof visualTypes)[number];

interface Props {
  type?: string | null;
  badge?: { titel: string; tekst?: string | null; icoon?: string | null } | null;
  donker?: boolean;
  class?: string;
}
const { type = 'dashboard', badge, class: className = '' } = Astro.props;
const t = (visualTypes as readonly string[]).includes(type ?? '') ? (type as VisualType) : 'dashboard';
const donker = Astro.props.donker ?? (t === 'code' || t === 'ai');
const lijn = 'M0 60 C 30 56, 50 40, 80 44 S 130 22, 160 26 S 210 8, 240 6';
const staven = [38, 52, 44, 63, 58, 74, 69, 86, 80, 100];
const uptime = Array.from({ length: 30 }, (_, i) => (i === 17 ? 'bg-paars' : 'bg-emerald-400'));
---

<div class:list={['relative', className]} aria-hidden="true">
  <div class="absolute -top-5 -right-4 -z-10 hidden grid-cols-3 gap-2 sm:grid">
    <span class="size-4 rounded-[4px] bg-paars"></span><span class="size-4"></span><span class="size-4 rounded-[4px] bg-paars-200"></span>
    <span class="size-4"></span><span class="size-4 rounded-[4px] bg-paars-200"></span>
  </div>

  <div class:list={['overflow-hidden rounded-[14px] border shadow-[0_30px_70px_-30px_rgb(10_13_49/0.35)]', donker ? 'border-navy-600 bg-navy' : 'border-lijn bg-white']}>
    <div class:list={['flex items-center gap-1.5 border-b px-4 py-3', donker ? 'border-navy-600' : 'border-lijn bg-lavendel']}>
      <span class="size-2.5 rounded-full bg-[#ff5f57]"></span><span class="size-2.5 rounded-full bg-[#febc2e]"></span><span class="size-2.5 rounded-full bg-[#28c840]"></span>
      <span class:list={['ml-3 h-5 flex-1 rounded-full', donker ? 'bg-navy-700' : 'bg-white']}></span>
    </div>

    <div class:list={['p-5 sm:p-6', badge && 'pb-24 sm:pb-20']}>
      {
        t === 'dashboard' && (
          <div class="flex flex-col gap-4">
            <div class="grid grid-cols-3 gap-3">
              {[['Sessies', '+18%'], ['Conversie', '+0,6 pt'], ['Omzet', '+24%']].map(([l, v]) => (
                <div class="rounded-[10px] border border-lijn p-3">
                  <div class="text-[11px] text-stil">{l}</div>
                  <div class="mt-1 text-lg leading-none font-bold text-navy">{v}</div>
                </div>
              ))}
            </div>
            <div class="flex gap-4">
              <div class="flex-[2] rounded-[10px] border border-lijn p-3">
                <div class="mb-2 text-[11px] text-stil">Omzet per week</div>
                <svg viewBox="0 0 240 70" class="h-24 w-full text-paars"><path d={`${lijn} V70 H0Z`} fill="currentColor" opacity=".12" /><path d={lijn} stroke="currentColor" stroke-width="2.5" fill="none" class="teken-lijn" /></svg>
              </div>
              <div class="flex flex-1 flex-col items-center justify-center rounded-[10px] border border-lijn p-3">
                <svg viewBox="0 0 42 42" class="size-20 -rotate-90"><circle cx="21" cy="21" r="15.9" fill="none" stroke="#ede4ff" stroke-width="6" /><circle cx="21" cy="21" r="15.9" fill="none" stroke="#763cf7" stroke-width="6" stroke-dasharray="64 36" /><circle cx="21" cy="21" r="15.9" fill="none" stroke="#0a0d31" stroke-width="6" stroke-dasharray="18 82" stroke-dashoffset="-64" /></svg>
                <div class="mt-1 text-[11px] text-stil">Kanaalmix</div>
              </div>
            </div>
          </div>
        )
      }

      {
        t === 'heatmap' && (
          <div class="relative isolate overflow-hidden rounded-[10px] border border-lijn">
            <div class="flex flex-col gap-3 p-4">
              <div class="flex items-center justify-between"><span class="h-3 w-16 rounded bg-navy" /><span class="flex gap-2"><span class="h-2 w-8 rounded bg-lijn-sterk" /><span class="h-2 w-8 rounded bg-lijn-sterk" /><span class="h-2 w-8 rounded bg-lijn-sterk" /></span></div>
              <div class="h-20 rounded-md bg-paars-50" />
              <div class="grid grid-cols-3 gap-3">{[0, 1, 2].map(() => <div class="flex flex-col gap-1.5"><div class="aspect-square rounded-md bg-grijs" /><span class="h-2 w-3/4 rounded bg-lijn-sterk" /><span class="h-2 w-1/2 rounded bg-lijn" /></div>)}</div>
              <div class="h-7 w-28 rounded bg-paars" />
            </div>
            <div class="pointer-events-none absolute inset-0 mix-blend-multiply">
              <span class="absolute top-[34%] left-[22%] size-28 rounded-full bg-[radial-gradient(circle,#ff3b30_0%,#ffcc00_35%,rgb(52_199_89/0.5)_60%,transparent_72%)] opacity-80 blur-[2px]" />
              <span class="absolute top-[60%] left-[58%] size-24 rounded-full bg-[radial-gradient(circle,#ff9500_0%,#ffcc00_40%,rgb(52_199_89/0.45)_62%,transparent_72%)] opacity-75 blur-[2px]" />
              <span class="absolute top-[80%] left-[2%] size-20 rounded-full bg-[radial-gradient(circle,#ff3b30_0%,#ffcc00_40%,transparent_70%)] opacity-80 blur-[2px]" />
            </div>
          </div>
        )
      }

      {
        t === 'code' && (
          <div class="flex flex-col gap-2 font-mono text-[12px]">
            {[
              ['w-24 bg-paars-licht', 'w-32 bg-navy-tekst/40'],
              ['ml-4 w-20 bg-emerald-400/70', 'w-40 bg-navy-tekst/30'],
              ['ml-4 w-28 bg-[#febc2e]/70', 'w-16 bg-paars-licht/70'],
              ['ml-8 w-36 bg-navy-tekst/30', 'w-12 bg-emerald-400/60'],
              ['ml-8 w-24 bg-paars-licht/80', 'w-28 bg-navy-tekst/30'],
              ['ml-4 w-16 bg-navy-tekst/40', ''],
              ['w-10 bg-paars-licht', ''],
            ].map(([a, b], i) => (
              <div class="flex items-center gap-2"><span class="w-4 text-right text-navy-stil">{i + 1}</span><span class:list={['h-2.5 rounded', a]} />{b && <span class:list={['h-2.5 rounded', b]} />}</div>
            ))}
            <div class="mt-3 rounded-[8px] bg-navy-700 p-3 text-navy-tekst">
              <div><span class="text-paars-licht">$</span> bin/magento setup:upgrade</div>
              <div class="mt-1 text-emerald-400">✓ Tests geslaagd · deploy naar productie</div>
            </div>
          </div>
        )
      }

      {
        t === 'lighthouse' && (
          <div class="flex flex-col gap-5">
            <div class="grid grid-cols-4 gap-3">
              {['Performance', 'Toegankelijk', 'Best practices', 'SEO'].map((l) => (
                <div class="flex flex-col items-center gap-2 text-center">
                  <div class="relative size-16">
                    <svg viewBox="0 0 42 42" class="size-16 -rotate-90"><circle cx="21" cy="21" r="17" fill="#e7fbef" stroke="#28c840" stroke-width="3.5" /></svg>
                    <span class="absolute inset-0 flex items-center justify-center text-lg font-bold text-emerald-600">99</span>
                  </div>
                  <span class="text-[10px] leading-tight text-stil">{l}</span>
                </div>
              ))}
            </div>
            <div class="rounded-[10px] border border-lijn p-3">
              <div class="mb-2 flex justify-between text-[11px] text-stil"><span>Laadtijd</span><span>Luma → Hyvä</span></div>
              <div class="flex flex-col gap-2"><span class="h-2.5 w-full rounded bg-lijn-sterk" /><span class="h-2.5 w-[34%] rounded bg-paars" /></div>
            </div>
          </div>
        )
      }

      {
        t === 'migratie' && (
          <div class="flex flex-col gap-4">
            <div class="flex items-center gap-3">
              <div class="flex-1 rounded-[10px] border border-lijn p-3 text-center"><div class="text-[11px] text-stil">Huidig platform</div><div class="mt-1 font-bold text-navy">Oude shop</div></div>
              <LijnIcoon naam="op" class="rotate-45 text-paars" />
              <div class="flex-1 rounded-[10px] border border-paars bg-paars-50 p-3 text-center"><div class="text-[11px] text-paars">Nieuw</div><div class="mt-1 font-bold text-navy">Magento 2</div></div>
            </div>
            {[['Producten en categorieën', 100], ['Klanten en orders', 100], ['URL redirects', 100], ['SEO metadata', 82]].map(([l, p]) => (
              <div>
                <div class="mb-1 flex justify-between text-[11px] text-stil"><span>{l}</span><span>{p}%</span></div>
                <div class="h-2 rounded bg-lijn"><div class="h-2 rounded bg-paars" style={`width:${p}%`} /></div>
              </div>
            ))}
          </div>
        )
      }

      {
        t === 'checklist' && (
          <div class="flex flex-col gap-2.5">
            <div class="mb-1 text-[13px] font-semibold text-navy">Technische audit</div>
            {[['Code kwaliteit en modules', true], ['Hosting en performance', true], ['Security en patches', true], ['Documentatie en toegang', true], ['Roadmap opgesteld', false]].map(([l, ok]) => (
              <div class="flex items-center gap-3 rounded-[8px] border border-lijn px-3 py-2.5 text-[13px] text-navy">
                <span class:list={['inline-flex size-5 items-center justify-center rounded-full', ok ? 'bg-paars text-white' : 'border border-dashed border-paars']}>{ok && <LijnIcoon naam="vink" size={14} />}</span>
                {l}
              </div>
            ))}
          </div>
        )
      }

      {
        t === 'schild' && (
          <div class="flex flex-col gap-4">
            <div class="flex items-center gap-3 rounded-[10px] bg-emerald-50 p-3 text-[13px] font-medium text-emerald-700"><span class="puls-stip size-2.5 rounded-full bg-emerald-500" /> Alle systemen operationeel</div>
            <div>
              <div class="mb-2 flex justify-between text-[11px] text-stil"><span>Uptime laatste 30 dagen</span><span>99,98%</span></div>
              <div class="flex h-8 items-end gap-[3px]">{uptime.map((c) => <span class:list={['h-full flex-1 rounded-[2px]', c]} />)}</div>
            </div>
            <div class="flex flex-col gap-2">
              {['Security patch geïnstalleerd', 'Malware scan schoon', 'Back-up gecontroleerd'].map((l) => (
                <div class="flex items-center gap-2.5 text-[13px] text-navy"><LijnIcoon naam="schild" size={18} class="text-paars" />{l}</div>
              ))}
            </div>
          </div>
        )
      }

      {
        t === 'koppeling' && (
          <div class="relative mx-auto aspect-[4/3] max-w-[380px]">
            <svg viewBox="0 0 400 300" class="absolute inset-0 size-full text-paars-200" fill="none">
              {[[70, 60], [330, 60], [70, 240], [330, 240]].map(([x, y]) => <path d={`M200 150 L${x} ${y}`} stroke="currentColor" stroke-width="2" stroke-dasharray="6 6" />)}
            </svg>
            <div class="absolute top-1/2 left-1/2 flex size-24 -translate-x-1/2 -translate-y-1/2 flex-col items-center justify-center rounded-[16px] bg-paars text-white shadow-lg"><LijnIcoon naam="winkelwagen" /><span class="mt-1 text-[12px] font-semibold">Magento</span></div>
            {[['ERP', 'database', 'top-[6%] left-[2%]'], ['PIM', 'raster', 'top-[6%] right-[2%]'], ['WMS', 'lagen', 'bottom-[6%] left-[2%]'], ['Betalen', 'betalen', 'bottom-[6%] right-[2%]']].map(([l, i, pos]) => (
              <div class:list={['absolute flex items-center gap-2 rounded-[10px] border border-lijn bg-white px-3 py-2 text-[12px] font-semibold text-navy shadow-sm', pos]}><LijnIcoon naam={i} size={18} class="text-paars" />{l}</div>
            ))}
          </div>
        )
      }

      {
        t === 'zoek' && (
          <div class="flex flex-col gap-4">
            <div class="flex items-center gap-2 rounded-full border border-lijn px-4 py-2.5 text-[13px] text-navy"><LijnIcoon naam="zoek" size={16} class="text-stil" /> magento webshop laten maken</div>
            {[['jouwwebshop.nl', true], ['concurrent-a.nl', false], ['concurrent-b.nl', false]].map(([u, top], i) => (
              <div class:list={['rounded-[10px] p-3', top ? 'border border-paars bg-paars-50' : 'border border-lijn']}>
                <div class="flex items-center justify-between text-[11px] text-stil"><span>{u}</span>{top && <span class="rounded-full bg-paars px-2 py-0.5 font-semibold text-white">#1</span>}</div>
                <div class:list={['mt-1.5 h-2.5 rounded', top ? 'w-3/4 bg-paars' : 'w-2/3 bg-lijn-sterk']} />
                <div class="mt-1.5 h-2 w-11/12 rounded bg-lijn" />
              </div>
            ))}
          </div>
        )
      }

      {
        t === 'ads' && (
          <div class="flex flex-col gap-3">
            <div class="flex justify-between text-[11px] text-stil"><span>Campagne</span><span>ROAS</span></div>
            {[['Shopping · topproducten', 92], ['Search · merk', 78], ['Performance Max', 64], ['Social · retargeting', 55]].map(([l, p]) => (
              <div class="flex items-center gap-3">
                <span class="w-36 shrink-0 truncate text-[12px] text-navy">{l}</span>
                <div class="h-3 flex-1 rounded bg-lijn"><div class="h-3 rounded bg-paars" style={`width:${p}%`} /></div>
              </div>
            ))}
            <div class="mt-2 flex h-20 items-end gap-1.5">{staven.map((h, i) => <span class:list={['flex-1 rounded-t-[3px]', i === staven.length - 1 ? 'bg-paars' : 'bg-paars-100']} style={`height:${h}%`} />)}</div>
          </div>
        )
      }

      {
        t === 'mail' && (
          <div class="flex flex-col items-center gap-0">
            {[['bliksem', 'Trigger: winkelwagen verlaten', 'bg-navy text-white'], ['klok', 'Wacht 2 uur', 'border border-lijn bg-white text-navy'], ['mail', 'E-mail: vergeet je niets?', 'border border-paars bg-paars-50 text-navy'], ['klok', 'Wacht 1 dag', 'border border-lijn bg-white text-navy'], ['euro', 'E-mail: persoonlijke aanbieding', 'border border-paars bg-paars-50 text-navy']].map(([i, l, c], n) => (
              <>
                {n > 0 && <span class="h-4 w-px bg-paars-200" />}
                <div class:list={['flex w-full max-w-[300px] items-center gap-3 rounded-[10px] px-3 py-2.5 text-[12px] font-medium', c]}><LijnIcoon naam={i} size={18} class={n === 0 ? 'text-paars-licht' : 'text-paars'} />{l}</div>
              </>
            ))}
          </div>
        )
      }

      {
        t === 'content' && (
          <div class="grid grid-cols-[1.1fr_1fr] gap-4">
            <div class="flex aspect-[4/5] items-center justify-center rounded-[10px] bg-[linear-gradient(135deg,#ede4ff,#dccbff)] text-paars"><LijnIcoon naam="beeld" size={40} /></div>
            <div class="flex flex-col gap-2.5">
              <span class="h-3 w-full rounded bg-navy" /><span class="h-3 w-3/4 rounded bg-navy" />
              <span class="mt-2 h-2 w-full rounded bg-lijn-sterk" /><span class="h-2 w-11/12 rounded bg-lijn-sterk" /><span class="h-2 w-full rounded bg-lijn-sterk" /><span class="h-2 w-2/3 rounded bg-lijn-sterk" />
              <div class="mt-auto flex gap-2"><span class="rounded-full bg-paars-50 px-2 py-1 text-[10px] font-semibold text-paars">SEO</span><span class="rounded-full bg-paars-50 px-2 py-1 text-[10px] font-semibold text-paars">Social</span></div>
              <span class="h-7 w-24 rounded bg-paars" />
            </div>
          </div>
        )
      }

      {
        t === 'ai' && (
          <div class="flex flex-col gap-3 text-[13px]">
            <div class="max-w-[80%] self-end rounded-[12px] rounded-br-[4px] bg-paars px-3.5 py-2.5 text-white">Schrijf productteksten voor 400 nieuwe artikelen</div>
            <div class="flex max-w-[85%] items-start gap-2.5 rounded-[12px] rounded-bl-[4px] bg-navy-700 px-3.5 py-2.5 text-navy-tekst"><LijnIcoon naam="sparkle" size={18} class="mt-0.5 shrink-0 text-paars-licht" /><span>Klaar: 400 teksten in jullie tone of voice, ter controle in de PIM gezet.</span></div>
            <div class="mt-1 grid grid-cols-3 gap-2">{['Teksten', 'Zoeken', 'Support'].map((l) => <span class="rounded-[8px] border border-navy-600 px-2 py-2 text-center text-[11px] text-navy-tekst">{l}</span>)}</div>
          </div>
        )
      }
    </div>
  </div>

  {
    badge && (
      <div class="zweef absolute -bottom-8 left-4 flex max-w-[260px] items-center gap-3.5 rounded-[12px] border border-lijn bg-white p-4 shadow-[0_24px_50px_-20px_rgb(10_13_49/0.35)] sm:-left-8">
        <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-paars-50 text-paars"><LijnIcoon naam={badge.icoon ?? 'grafiek'} /></span>
        <span>
          <span class="block text-[14px] leading-snug font-semibold text-navy">{badge.titel}</span>
          {badge.tekst && <span class="mt-0.5 block text-[12px] leading-snug text-tekst">{badge.tekst}</span>}
        </span>
      </div>
    )
  }
</div>
