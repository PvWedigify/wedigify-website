---
import { bestaat } from '@/lib/site';

interface Props {
  klanten: { naam: string; logo?: string | null }[];
  titel?: string;
}
const { klanten, titel = 'Zij kozen Wedigify' } = Astro.props;
// Twee keer dezelfde reeks achter elkaar → naadloze loop (translateX -50%)
const reeks = [...klanten, ...klanten];
const duur = `${Math.max(klanten.length * 4, 24)}s`;
---

<section class="border-y border-lijn bg-white py-8 md:py-10" aria-label={titel}>
  <p class="mb-6 text-center text-[13px] font-medium tracking-[0.12em] text-stil uppercase">{titel}</p>
  <div class="marquee rand-fade-x overflow-hidden">
    <ul class="marquee-spoor items-center gap-14 pr-14 md:gap-20 md:pr-20" style={`--duur:${duur}`}>
      {
        reeks.map((k, i) => (
          <li class="shrink-0" aria-hidden={i >= klanten.length ? 'true' : undefined}>
            {bestaat(k.logo) ? (
              <img
                src={k.logo}
                alt={i < klanten.length ? k.naam : ''}
                loading="lazy"
                decoding="async"
                class="h-9 w-auto max-w-[150px] object-contain opacity-60 mix-blend-multiply grayscale transition duration-300 hover:opacity-100 hover:grayscale-0 md:h-11"
              />
            ) : (
              <span class="text-lg font-bold tracking-kop whitespace-nowrap text-stil">{k.naam}</span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
