---
import { getEntries, getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import Achtergrond from '@/components/Achtergrond.astro';
import HeroResultaten from '@/components/HeroResultaten.astro';
import KlantQuotes from '@/components/KlantQuotes.astro';
import LogoMarquee from '@/components/LogoMarquee.astro';
import DienstIndex from '@/components/DienstIndex.astro';
import CaseFeature from '@/components/CaseFeature.astro';
import CaseKaart from '@/components/CaseKaart.astro';
import AanpakBand from '@/components/AanpakBand.astro';
import PartnerSectie from '@/components/PartnerSectie.astro';
import Avatar from '@/components/Avatar.astro';
import ContactKaart from '@/components/ContactKaart.astro';
import KennisKaart from '@/components/KennisKaart.astro';
import { sfeerFotos } from '@/data/sfeer';
import { getHome, getSite, getDiensten, getTeam, bestaat } from '@/lib/site';

const home = await getHome();
const site = await getSite();
const magento = (await getDiensten('magento')).filter((d) => d.data.opHome);
const groei = await getDiensten('groei');
const cases = await getEntries(home.uitgelichteCases);
const heroCases = await getEntries(home.heroCases);
const [uitgelicht, ...overige] = cases;
const alleTeam = await getTeam();
const team = [...alleTeam.filter((t) => t.data.foto), ...alleTeam.filter((t) => !t.data.foto)].slice(0, 7);
const gezichten = alleTeam.filter((t) => bestaat(t.data.foto)).slice(0, 5);
const sfeer = sfeerFotos.filter((f) => bestaat(f.src));
const contactpersoon = site.contactpersoon ? (await getEntries([site.contactpersoon]))[0] : null;
const kennis = (await getCollection('kennis')).sort((x, y) => y.data.datum.valueOf() - x.data.datum.valueOf()).slice(0, 3);

---

<Base
  titel="Wedigify | Magento Agency | Magento E-commerce Specialisten"
  omschrijving="Wij zijn Wedigify, een technisch en datagedreven Magento agency uit Rotterdam. Magento e-commerce specialisten in Hyvä, migraties en groei."
>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden bg-lavendel">
    <Achtergrond />
    <div class="container-w relative grid items-center gap-x-12 gap-y-14 pt-12 pb-16 md:pt-20 md:pb-24 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] lg:pt-24">
      <div>
        <p class="inline-flex items-center gap-2.5 rounded-full border border-lijn-sterk bg-white/80 py-1.5 pr-4 pl-2 text-[13px] font-medium text-tekst backdrop-blur">
          <span class="puls-stip size-2 rounded-full bg-paars" aria-hidden="true"></span>
          {home.heroEyebrow}
        </p>
        <h1 class="mt-7 text-[clamp(2.5rem,4.3vw,3.8rem)] leading-[1.04] tracking-strak">
          <span class="block">{home.heroTitel}</span>
          <span class="block text-balance text-paars">{home.heroAccent}</span>
        </h1>
        <p class="lead mt-8 max-w-[540px] md:text-xl">{home.heroIntro}</p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href="/contact/" class="knop-paars shadow-[0_10px_30px_-10px_rgb(118_60_247/0.7)]">Plan een groeisessie <Icon name="pijl" size={18} /></a>
          <a href="/magento-scan/" class="knop-rand bg-white/60">Laat je shop scannen</a>
        </div>
        <a href="/over-ons/team/" class="group mt-12 flex items-center gap-4 border-t border-lijn-sterk pt-6 hover:text-navy">
          <span class="flex -space-x-3">
            {gezichten.map((t) => <img src={t.data.foto} alt="" width="48" height="48" class="size-12 rounded-full object-cover ring-[3px] ring-lavendel" />)}
            <span class="inline-flex size-12 items-center justify-center rounded-full bg-paars text-sm font-bold text-white ring-[3px] ring-lavendel">+{Math.max(alleTeam.length - gezichten.length, 0)}</span>
          </span>
          <span class="text-[15px] leading-snug">
            <span class="block font-semibold text-navy group-hover:text-paars">Een vast team van {alleTeam.length} specialisten</span>
            <span class="block text-tekst">Developers, marketeers en strategen in Rotterdam</span>
          </span>
        </a>
      </div>
      {heroCases.length > 0 && <HeroResultaten cases={heroCases} />}
    </div>
  </section>

  {site.klanten.length > 0 && <LogoMarquee klanten={site.klanten} />}

  <!-- Pijler 1: Magento -->
  <section class="relative isolate overflow-hidden bg-grijs">
    <div class="stippen-donker fade-onder pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
    <div class="container-w sectie relative">
      <div class="mb-12 flex flex-wrap items-end justify-between gap-x-16 gap-y-6" data-reveal>
        <div>
          <p class="eyebrow mb-4">Pijler 1 · Magento development</p>
          <h2 class="kop-2">
            {home.magentoTitel} <span class="text-paars">{home.magentoAccent}</span>.
          </h2>
        </div>
        <p class="lead max-w-[420px]">{home.magentoIntro}</p>
      </div>
      <DienstIndex diensten={magento} />
      <a href="/magento/" class="knop-rand mt-10">Alle Magento diensten <Icon name="pijl" size={18} /></a>
    </div>
  </section>

  <!-- Pijler 2: Groei -->
  <section class="relative isolate overflow-hidden bg-navy text-white">
    <div class="gloed-donker pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="raster-licht pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
    <div class="container-w sectie relative grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
        <p class="eyebrow mb-4 text-paars-200">Pijler 2 · Online groei</p>
        <h2 class="kop-2 text-white">Groei, met een <span class="text-paars-200">specialist per kanaal</span>.</h2>
        <p class="lead mt-6 max-w-[460px] text-white/75">Een webshop bouwen is stap één. Daarna gaat het om bezoekers, conversie en omzet. Een digitale strateeg brengt SEO, SEA, social, e-mail, CRO en content samen in één business case, online en offline.</p>
        <ul class="mt-8 space-y-3 text-white/85">
          {['Eén strateeg als vast aanspreekpunt', 'Een eigen specialist per kanaal', 'Sturen op omzet en marge, niet op klikken'].map((p) => (
            <li class="flex items-start gap-3"><span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-paars text-white"><Icon name="check" size={14} /></span>{p}</li>
          ))}
        </ul>
        <a href="/groei/" class="knop-paars mt-10">Alle groeidiensten <Icon name="pijl" size={18} /></a>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2">
        {
          groei.map((d, i) => {
            const sp = d.data.specialist ? alleTeam.find((t) => t.id === d.data.specialist?.id) : undefined;
            return (
              <li data-reveal style={`--vertraging:${(i % 2) * 80}ms`}>
                <a href={`/groei/${d.id}/`} class="group flex h-full flex-col rounded-kaart border border-white/10 bg-white/[0.04] p-6 text-white transition-all duration-300 hover:-translate-y-1 hover:border-paars hover:bg-white/[0.08] hover:text-white">
                  <span class="text-[13px] font-semibold text-paars-200">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="mt-3 text-xl font-semibold tracking-kop text-white">{d.data.titel}</h3>
                  <p class="mt-2 flex-1 text-[15px] leading-relaxed text-white/70">{d.data.kort}</p>
                  {sp && (
                    <div class="mt-5 flex items-center gap-3 border-t border-white/10 pt-4">
                      {sp.data.foto ? <img src={sp.data.foto} alt="" width="32" height="32" loading="lazy" decoding="async" class="size-8 rounded-full object-cover" /> : <span class="inline-flex size-8 items-center justify-center rounded-full bg-paars text-xs font-bold">{sp.data.naam.charAt(0)}</span>}
                      <span class="text-[13px] leading-tight text-white/60"><span class="font-semibold text-white/90">{sp.data.naam}</span><br />{sp.data.rol}</span>
                    </div>
                  )}
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <!-- Cases -->
  <section class="container-w sectie">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4" data-reveal>
      <h2 class="kop-2">Resultaten <span class="text-paars">die we samen boekten.</span></h2>
      <a href="/cases/" class="link-onderstreept">Alle cases</a>
    </div>
    {uitgelicht && <div data-reveal><CaseFeature item={uitgelicht} /></div>}
    <div class="mt-5 grid gap-5 md:grid-cols-3">
      {overige.map((c, i) => <div data-reveal style={`--vertraging:${i * 100}ms`}><CaseKaart item={c} /></div>)}
    </div>
  </section>

  <KlantQuotes achtergrond="lavendel" />

  <!-- Team en mentaliteit -->
  <section class="container-w sectie">
    <div class="grid items-center gap-x-16 gap-y-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)]">
      <div data-reveal>
        <p class="eyebrow mb-5">Wie we zijn</p>
        <h2 class="kop-2 mb-5">{home.teamTitel}</h2>
        <p class="lead">{home.teamIntro}</p>
        <ol class="mt-8 flex flex-col gap-5 border-l-2 border-paars-100 pl-6">
          {home.manifest.map((m) => (
            <li>
              <h3 class="text-lg font-semibold tracking-kop">{m.titel}</h3>
              <p class="mt-1 leading-relaxed text-tekst">{m.tekst}</p>
            </li>
          ))}
        </ol>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/over-ons/" class="knop-rand">Maak kennis met ons <Icon name="pijl" size={18} /></a>
          <a href="/werken-bij/" class="link-onderstreept self-center">Werken bij Wedigify</a>
        </div>
      </div>
      <div class="min-w-0" data-reveal style="--vertraging:120ms">
        {
          sfeer.length >= 3 ? (
            <div class="grid grid-cols-6 gap-2.5">
              {sfeer.slice(0, 3).map((f, i) => (
                <figure class:list={['relative overflow-hidden rounded-kaart', i === 0 ? 'col-span-6 aspect-[16/9]' : 'col-span-3 aspect-[4/3]']}>
                  <img src={f.src} alt={f.alt} loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover" />
                </figure>
              ))}
            </div>
          ) : (
            <div class="grid grid-cols-4 gap-2.5">
              {team.map((t) => (
                <Avatar naam={t.data.naam} foto={t.data.foto} formaat="vierkant" />
              ))}
              <a href="/over-ons/team/" class="flex aspect-square items-center justify-center rounded-kaart bg-paars text-2xl font-bold text-white transition-colors hover:bg-paars-donker hover:text-white">+{Math.max(alleTeam.length - 7, 0)}</a>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <AanpakBand titel={home.aanpakTitel ?? ''} intro={home.aanpakIntro} />

  <PartnerSectie />

  {
    kennis.length > 0 && (
      <section class="container-w sectie">
        <div class="mb-10 flex flex-wrap items-end justify-between gap-4" data-reveal>
          <div>
            <p class="eyebrow mb-4">Kennis</p>
            <h2 class="kop-2">Inzichten over Magento <span class="text-paars">en e-commerce.</span></h2>
          </div>
          <a href="/kennis/" class="link-onderstreept">Alle artikelen</a>
        </div>
        <ul class="grid gap-5 md:grid-cols-3">
          {kennis.map((a, i) => (
            <li data-reveal style={`--vertraging:${i * 90}ms`}><KennisKaart artikel={a} /></li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- Slot -->
  <section class="relative isolate overflow-hidden bg-lavendel">
    <Achtergrond />
    <div class="container-w sectie relative flex flex-wrap items-end justify-between gap-10">
      <div class="min-w-0 flex-[1_1_560px]" data-reveal>
        <h2 class="mb-8 max-w-[900px] text-[clamp(2.25rem,4.6vw,4.25rem)] leading-[1.04] font-bold tracking-strak">
          {home.ctaTitel}<br /><span class="text-paars">{home.ctaAccent}</span>
        </h2>
        <div class="inline-flex flex-wrap gap-3">
          <a href="/contact/" class="knop-paars">Plan een groeisessie <Icon name="pijl" size={18} /></a>
          {site.telefoon && <a href={`tel:${site.telefoonLink}`} class="knop-rand bg-white/60"><Icon name="telefoon" size={18} /> {site.telefoon}</a>}
        </div>
        <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-tekst">
          {['Vrijblijvend gesprek', 'Direct een specialist aan tafel', 'Geen verplichtingen'].map((p) => (
            <li class="flex items-center gap-2"><span class="inline-flex size-5 items-center justify-center rounded-full bg-paars text-white"><Icon name="check" size={12} /></span>{p}</li>
          ))}
        </ul>
      </div>
      <div data-reveal style="--vertraging:150ms"><ContactKaart persoon={contactpersoon} /></div>
    </div>
  </section>
</Base>
